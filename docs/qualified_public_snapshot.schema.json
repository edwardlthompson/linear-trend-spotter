{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "qualified_public_snapshot",
  "type": "object",
  "required": ["schema_version", "updated_at", "coins"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "description": "ISO-8601 UTC timestamp when the worker wrote the file" },
    "coins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol"],
        "properties": {
          "symbol": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": ["string", "null"] },
          "source_url": { "type": ["string", "null"] },
          "gains": {
            "type": "object",
            "properties": {
              "7d": { "type": "number" },
              "30d": { "type": "number" }
            }
          },
          "uniformity_score": { "type": "number" },
          "health_score": { "type": ["number", "null"] },
          "current_rank": { "type": ["integer", "null"] },
          "rank_delta": { "type": ["integer", "null"] },
          "exchange_volumes": { "type": ["object", "null"] },
          "volume_24h": { "type": ["number", "null"] },
          "ohlcv_source": { "type": ["string", "null"] }
        }
      }
    }
  }
}
