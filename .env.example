# Optional: folder for scanner DB + qualified_public_snapshot.json (defaults to repo root if unset).
# DATA_DIR=C:\path\to\your\data

CMC_API_KEY=your_key_here
# Optional: local automation only (scripts/render_snapshot_relay_env.py). Create at
# https://dashboard.render.com/u/settings#api-keys — never commit a real key.
# RENDER_API_KEY=
# Delivery: use telegram for group alerts; set web for dashboard-only (see docs/DELIVERY_MODE.md).
DELIVERY_MODE=telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
CHART_IMG_API_KEY=your_key_here
# COINGECKO_API_KEY=optional_demo_key

# Public dashboard JSON (config default: on). For GitHub Pages, deploy snapshot_server and set:
# QUALIFIED_SNAPSHOT_RELAY_URL=https://your-snapshot.onrender.com
# QUALIFIED_SNAPSHOT_RELAY_SECRET=shared_secret_same_as_relay
